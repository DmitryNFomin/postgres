#!/usr/bin/env bash
# Fake pg_test_timing: 02-run-matrix.sh runs this once per installation in
# preflight and only checks the exit code (output goes straight to a log
# file). Answers instantly instead of running for -d seconds.
set -euo pipefail
echo "Testing timing overhead for 2 seconds."
echo "Per loop time including overhead: 35.00 ns"
echo "Histogram of timing durations:"
echo "  < us   % of total      count"
echo "     1     99.00000   50000000"
echo "     2      1.00000     500000"
exit 0
